{
  "name": "entre-skill-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "jest --config jest.config.js --coverage --coverageDirectory=coverage/unit --forceExit",
    "test:integration": "jest --config jest.config.js --testPathPattern=integration --coverage --coverageDirectory=coverage/integration --forceExit",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:integration",
    "coverage:merge": "lcov-result-merger 'coverage/**/lcov.info' coverage/lcov.info",
    "coverage:report": "npm run coverage:merge && nyc report --reporter=lcov --report-dir=coverage",
    "seed:test": "tsx scripts/seed-test-data.ts",
    "seed:prod": "tsx scripts/seed-production.ts",
    "seed:learn": "tsx scripts/seed-learn.ts",
    "migrate": "tsx scripts/run-migration.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@sentry/nextjs": "^10.67.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^8.0.1",
    "@upstash/redis": "^1.38.0",
    "@vercel/kv": "^3.0.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "mongoose": "^9.8.0",
    "next": "16.2.11",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.13",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.0",
    "shadcn": "^4.13.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^7.2.1",
    "babel-jest": "^30.4.1",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "jest": "^30.4.2",
    "lcov-result-merger": "^6.0.0",
    "mongodb-memory-server": "^11.2.0",
    "nyc": "^18.0.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
